# ── Postgres ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sika

# ── Better Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# Required to create the first and only account. Generate independently with:
# openssl rand -hex 32
SIKA_SETUP_TOKEN=replace_with_a_unique_setup_token

# ── Site URL ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Optional self-hosted Web Push reminders ──────────────────────
# Generate once with: npx web-push generate-vapid-keys --json
# WEB_PUSH_VAPID_PUBLIC_KEY=
# WEB_PUSH_VAPID_PRIVATE_KEY=
# Contact URI for the server operator (mailto: or HTTPS URL)
# WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com
# Generate independently with: openssl rand -hex 32
# NOTIFICATION_DISPATCH_TOKEN=

# ── Optional backup monitoring ───────────────────────────────────
# Generate independently with: openssl rand -hex 32
# Call POST /api/backup-status/report with this bearer token only after validating a backup.
# BACKUP_REPORT_TOKEN=

# ── Optional SMTP email reminders ────────────────────────────────
# URL-encode special characters in credentials.
# SMTP_URL=smtp://USER:PASSWORD@mail.example.com:587
# Use smtps://...:465 for implicit TLS.
# SMTP_FROM=Sika <sika@example.com>

# ── OpenAI (receipt scanning) ────────────────────────────────────
# Only ever sent to https://api.openai.com; users of other providers enter their own key.
OPENAI_API_KEY=your_openai_api_key
# Allow http:// and private-network AI endpoints such as a local Ollama.
# Any signed-in user can then make the server call internal hosts, so enable only on trusted installs.
# SIKA_ALLOW_PRIVATE_AI_ENDPOINTS=true

# ── S3-compatible storage (receipts) ─────────────────────────────
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=sika-receipts
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
# Optional: public URL prefix for stored objects
# S3_PUBLIC_URL=https://cdn.example.com

# ── Runtime DB migration + schema gate (Docker startup) ─────────
# Keep as false in production. If true, app skips auto-migrate step.
SKIP_DB_AUTO_MIGRATE=false
# Optional retry tuning for DB connection during auto-migrate
DB_MIGRATE_RETRIES=20
DB_MIGRATE_RETRY_DELAY_MS=2000

# Keep as false in production. If true, app skips schema verification.
SKIP_DB_SCHEMA_CHECK=false
# Optional retry tuning for schema check
DB_SCHEMA_CHECK_RETRIES=20
DB_SCHEMA_CHECK_RETRY_DELAY_MS=2000

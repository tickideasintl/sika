#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

export DEBIAN_FRONTEND=noninteractive
export NEXT_TELEMETRY_DISABLED=1

echo "[setup] Checking Node.js"
node_version="$(node --version 2>/dev/null || true)"
node_release="24.22.1"
if [[ "$node_version" != "v$node_release" ]]; then
  echo "[setup] Installing Node.js $node_release"
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends ca-certificates curl xz-utils

  case "$(uname -m)" in
    x86_64)
      node_arch="x64"
      node_sha256="6c172a9ab6718f7b801fb5a7bd486af2ee5e32758086a04b84fcce2aa77095e6"
      ;;
    aarch64)
      node_arch="arm64"
      node_sha256="dbabf7a1cbf947e6059ffad2c27b80041db97dea1e553b62afdee7f13fca336e"
      ;;
    *) echo "[setup] Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac

  archive="$(mktemp)"
  trap 'rm -f "$archive"' EXIT
  curl -fsSL "https://nodejs.org/dist/v$node_release/node-v$node_release-linux-$node_arch.tar.xz" -o "$archive"
  echo "$node_sha256  $archive" | sha256sum --check --status || {
    echo "[setup] Node.js archive checksum verification failed" >&2
    exit 1
  }
  sudo rm -rf "/opt/node-v$node_release"
  sudo mkdir -p "/opt/node-v$node_release"
  sudo tar -xJf "$archive" --strip-components=1 --no-same-owner --no-same-permissions \
    -C "/opt/node-v$node_release"
  for executable in node npm npx corepack; do
    sudo ln -sfn "/opt/node-v$node_release/bin/$executable" "/usr/local/bin/$executable"
  done
  rm -f "$archive"
  trap - EXIT
fi

if [[ ! -d /etc/postgresql/16/main ]]; then
  echo "[setup] Installing PostgreSQL 16"
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends ca-certificates curl gpg
  sudo install -d -m 0755 /usr/share/postgresql-common/pgdg
  pgdg_key="$(mktemp)"
  trap 'rm -f "$pgdg_key"' EXIT
  curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc -o "$pgdg_key"
  pgdg_fingerprint="$(gpg --batch --show-keys --with-colons "$pgdg_key" \
    | awk -F: '$1 == "fpr" { print $10; exit }')"
  if [[ "$pgdg_fingerprint" != "B97B0AFCAA1A47F044F244A07FCC7D46ACCC4CF8" ]]; then
    echo "[setup] PostgreSQL signing-key fingerprint verification failed" >&2
    exit 1
  fi
  sudo install -m 0644 "$pgdg_key" \
    /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc
  rm -f "$pgdg_key"
  trap - EXIT
  echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
    | sudo tee /etc/apt/sources.list.d/pgdg.list >/dev/null
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends postgresql-16
fi

echo "[setup] Starting PostgreSQL"
if ! sudo pg_ctlcluster 16 main status >/dev/null 2>&1; then
  sudo pg_ctlcluster 16 main start
fi

echo "[setup] Provisioning local database"
db_password="${SIKA_DB_PASSWORD:-localdev}"
# Double every single quote so the password is a safe SQL string literal.
db_password_sql="${db_password//\'/\'\'}"
# Percent-encode the password so reserved characters survive the connection URI.
url_encode() {
  local string="$1" encoded="" i char
  for (( i = 0; i < ${#string}; i++ )); do
    char="${string:i:1}"
    case "$char" in
      [A-Za-z0-9.~_-]) encoded+="$char" ;;
      *) encoded+="$(printf '%%%02X' "'$char")" ;;
    esac
  done
  printf '%s' "$encoded"
}
db_url="postgresql://sika:$(url_encode "$db_password")@localhost:5432/sika"
if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = 'sika'" | grep -q 1; then
  sudo -u postgres psql -v ON_ERROR_STOP=1 \
    -c "CREATE ROLE sika LOGIN PASSWORD '$db_password_sql'"
else
  sudo -u postgres psql -v ON_ERROR_STOP=1 \
    -c "ALTER ROLE sika WITH LOGIN PASSWORD '$db_password_sql'" >/dev/null
fi

if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname = 'sika'" | grep -q 1; then
  sudo -u postgres createdb --owner=sika sika
fi

if [[ ! -f .env.local ]]; then
  echo "[setup] Creating .env.local with orb development defaults"
  umask 077
  auth_secret="$(openssl rand -base64 32)"
  cat > .env.local <<EOF
DATABASE_URL=$db_url
BETTER_AUTH_SECRET=$auth_secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
EOF
fi

echo "[setup] Installing npm dependencies"
npm ci

echo "[setup] Applying database migrations"
DATABASE_URL="$db_url" npm run db:migrate

echo "[setup] Complete"
